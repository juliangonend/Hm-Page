{
  "name": "hockey-management/backoffice-api",
  "description": "Back office API for Hockey Management upcoming events (PHP 8 + MySQL).",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "ext-pdo": "*",
    "ext-gd": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": { "HmApi\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "HmApi\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "phpunit",
    "serve": "php -S localhost:8000 -t public public/index.php"
  },
  "config": { "sort-packages": true }
}
